"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useParams } from "next/navigation";

type Studio = {
_id: string;
title: string;
category: string;
hourlyRate: number;
securityDeposit: number;
maxCapacity: number;
location: string;
image: string;
rating: number;
amenities: string[];
overview: string;
hostName: string;
hostEmail: string;
};

export default function StudioDetailsPage() {
const params = useParams<{ id: string }>();
const id = params.id;

const [studio, setStudio] = useState<Studio | null>(null);
const [loading, setLoading] = useState(true);
const [error, setError] = useState("");
const [showBooking, setShowBooking] = useState(false);
const [bookingDate, setBookingDate] = useState("");
const [startTime, setStartTime] = useState("10:00");
const [endTime, setEndTime] = useState("12:00");
const [guests, setGuests] = useState("2");
const [bookingMessage, setBookingMessage] = useState("");

useEffect(() => {
if (!id) return;


async function fetchStudio() {
  try {
    setLoading(true);
    setError("");

    const response = await fetch(
      `http://localhost:5000/api/studios/${id}`
    );

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(result.message || "Studio not found.");
    }

    setStudio(result.data);
  } catch (err) {
    setError(
      err instanceof Error
        ? err.message
        : "Unable to load studio details."
    );
  } finally {
    setLoading(false);
  }
}

fetchStudio();


}, [id]);

if (loading) {
return ( <main className="min-h-screen bg-[#faf9f6] px-5 py-20"> <div className="mx-auto max-w-6xl animate-pulse"> <div className="h-8 w-64 rounded bg-gray-200" /> <div className="mt-6 h-96 rounded-3xl bg-gray-200" /> <div className="mt-6 h-8 w-1/2 rounded bg-gray-200" /> <div className="mt-4 h-5 w-3/4 rounded bg-gray-200" /> </div> </main>
);
}

if (error || !studio) {
return ( <main className="flex min-h-screen items-center justify-center bg-[#faf9f6] px-5"> <div className="max-w-lg rounded-3xl border border-gray-200 bg-white p-10 text-center"> <div className="text-5xl" aria-hidden="true">🏢</div> <h1 className="mt-5 text-3xl font-black">Studio not found</h1> <p className="mt-3 text-gray-600">
{error || "This creative space may no longer be available."} </p> <Link
         href="/studios"
         className="mt-7 inline-flex rounded-full bg-[#20231f] px-6 py-3 font-bold text-white hover:bg-[#42483d]"
       >
← Explore Studios </Link> </div> </main>
);
}

async function handleBookingRequest(
  event: React.FormEvent<HTMLFormElement>
) {
  event.preventDefault();

  if (!bookingDate || !startTime || !endTime) {
    setBookingMessage("Please complete all booking fields.");
    return;
  }

  const today = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Dhaka",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(new Date());

  if (bookingDate < today) {
    setBookingMessage("Please select today or a future date.");
    return;
  }

  if (endTime <= startTime) {
    setBookingMessage("End time must be later than start time.");
    return;
  }

  setBookingMessage("Submitting your booking request...");

  try {
    const response = await fetch("/api/bookings", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        studioId: studio._id,
        bookingDate,
        startTime,
        endTime,
        guests: Number(guests),
      }),
    });

    const result = await response.json();

    if (!response.ok) {
      if (response.status === 401) {
        setBookingMessage(
          "Please log in before submitting a booking request."
        );
        return;
      }

      setBookingMessage(
        result.message || "Unable to submit your booking request."
      );
      return;
    }

    setBookingMessage(
      "Booking request submitted successfully! Check My Bookings for its status."
    );
  } catch (error) {
    console.error("Booking submission error:", error);
    setBookingMessage("Something went wrong. Please try again.");
  }
}

return ( <main className="min-h-screen bg-[#faf9f6] text-[#20231f]"> <section className="mx-auto max-w-7xl px-5 py-8 lg:px-8"> <Link
       href="/studios"
       className="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-[#668b18]"
     >
← Back to Explore Studios </Link>


    <div className="mt-6 flex flex-wrap items-start justify-between gap-4">
      <div>
        <span className="rounded-full bg-[#eaf2d9] px-4 py-2 text-sm font-bold text-[#526e1e]">
          {studio.category}
        </span>

        <h1 className="mt-5 text-3xl font-black sm:text-5xl">
          {studio.title}
        </h1>

        <p className="mt-4 text-gray-600">
          📍 {studio.location}
          <span className="mx-3">·</span>
          ★ {studio.rating} rating
          <span className="mx-3">·</span>
          Up to {studio.maxCapacity} guests
        </p>
      </div>

      <div className="rounded-2xl border border-gray-200 bg-white p-5">
        <p className="text-sm text-gray-500">Hourly rate</p>
        <p className="mt-1 text-3xl font-black">
          ৳{studio.hourlyRate.toLocaleString("en-BD")}
          <span className="text-sm font-medium text-gray-500"> / hour</span>
        </p>
      </div>
    </div>

    <div className="mt-8 overflow-hidden rounded-3xl bg-gray-200">
      <img
        src={studio.image}
        alt={studio.title}
        className="h-[300px] w-full object-cover sm:h-[480px]"
      />
    </div>

    <div className="mt-10 grid gap-10 lg:grid-cols-[1fr_360px]">
      <div className="space-y-10">
        <section>
          <h2 className="text-2xl font-black">About this space</h2>
          <p className="mt-4 whitespace-pre-line leading-8 text-gray-600">
            {studio.overview || "No description has been added yet."}
          </p>
        </section>

        <section>
          <h2 className="text-2xl font-black">Studio details</h2>

          <div className="mt-5 grid gap-4 sm:grid-cols-2">
            <div className="rounded-2xl border border-gray-200 bg-white p-5">
              <p className="text-sm text-gray-500">Maximum capacity</p>
              <p className="mt-2 text-lg font-bold">
                👥 {studio.maxCapacity} guests
              </p>
            </div>

            <div className="rounded-2xl border border-gray-200 bg-white p-5">
              <p className="text-sm text-gray-500">Security deposit</p>
              <p className="mt-2 text-lg font-bold">
                ৳{studio.securityDeposit.toLocaleString("en-BD")}
              </p>
            </div>

            <div className="rounded-2xl border border-gray-200 bg-white p-5">
              <p className="text-sm text-gray-500">Category</p>
              <p className="mt-2 text-lg font-bold">{studio.category}</p>
            </div>

            <div className="rounded-2xl border border-gray-200 bg-white p-5">
              <p className="text-sm text-gray-500">Location</p>
              <p className="mt-2 text-lg font-bold">{studio.location}</p>
            </div>
          </div>
        </section>

        <section>
          <h2 className="text-2xl font-black">Amenities</h2>

          {studio.amenities?.length ? (
            <div className="mt-5 flex flex-wrap gap-3">
              {studio.amenities.map((amenity) => (
                <span
                  key={amenity}
                  className="rounded-full border border-gray-200 bg-white px-5 py-3 text-sm font-medium"
                >
                  ✓ {amenity}
                </span>
              ))}
            </div>
          ) : (
            <p className="mt-3 text-gray-500">
              No amenities have been listed yet.
            </p>
          )}
        </section>

        <section>
          <h2 className="text-2xl font-black">Your host</h2>

          <div className="mt-5 flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5">
            <div className="flex h-14 w-14 items-center justify-center rounded-full bg-[#eaf2d9] text-2xl font-black">
              {studio.hostName?.charAt(0).toUpperCase() || "H"}
            </div>

            <div>
              <p className="font-bold">
                {studio.hostName || "Studio Host"}
              </p>
              <p className="mt-1 text-sm text-gray-500">
                StudioSpace host
              </p>
            </div>
          </div>
        </section>
      </div>

      <aside className="h-fit rounded-3xl border border-gray-200 bg-white p-6 shadow-sm lg:sticky lg:top-24">
        <p className="text-sm text-gray-500">Reserve this workspace</p>

        <p className="mt-2 text-3xl font-black">
          ৳{studio.hourlyRate.toLocaleString("en-BD")}
          <span className="text-sm font-medium text-gray-500"> / hour</span>
        </p>

        <div className="mt-5 space-y-3 border-y border-gray-100 py-5 text-sm">
          <div className="flex justify-between gap-3">
            <span className="text-gray-500">Security deposit</span>
            <span className="font-semibold">
              ৳{studio.securityDeposit.toLocaleString("en-BD")}
            </span>
          </div>

          <div className="flex justify-between gap-3">
            <span className="text-gray-500">Capacity</span>
            <span className="font-semibold">
              {studio.maxCapacity} guests
            </span>
          </div>
        </div>

        <button
          onClick={() => {
            setShowBooking(true);
            setBookingMessage("");
          }}
          className="mt-5 w-full rounded-full bg-[#dfff64] px-6 py-4 font-black transition hover:bg-[#c9ef43]"
        >
          Book Workspace Now ↗
        </button>

        <p className="mt-4 text-center text-xs leading-5 text-gray-500">
          Booking is subject to host confirmation and availability.
        </p>
      </aside>
    </div>
  </section>

  {showBooking && (
    <div
      className="fixed inset-0 z-[100] flex items-center justify-center overflow-y-auto bg-black/60 p-4"
      onMouseDown={(event) => {
        if (event.target === event.currentTarget) {
          setShowBooking(false);
        }
      }}
    >
      <section
        role="dialog"
        aria-modal="true"
        aria-labelledby="booking-title"
        className="my-8 w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl sm:p-8"
      >
        <div className="flex items-start justify-between gap-4">
          <div>
            <p className="text-sm font-bold uppercase tracking-widest text-[#668b18]">
              Make it yours
            </p>
            <h2 id="booking-title" className="mt-2 text-2xl font-black">
              Request a booking
            </h2>
            <p className="mt-2 text-sm text-gray-500">{studio.title}</p>
          </div>

          <button
            type="button"
            onClick={() => setShowBooking(false)}
            aria-label="Close booking dialog"
            className="rounded-full bg-gray-100 px-3 py-2 font-bold hover:bg-gray-200"
          >
            ✕
          </button>
        </div>

        <form onSubmit={handleBookingRequest} className="mt-6 space-y-4">
          <div>
            <label htmlFor="booking-date" className="mb-2 block text-sm font-bold">
              Booking date
            </label>
            <input
              id="booking-date"
              type="date"
              min={new Date().toLocaleDateString("en-CA")}
              value={bookingDate}
              onChange={(event) => setBookingDate(event.target.value)}
              required
              className="w-full rounded-xl border border-gray-200 px-4 py-3 outline-none focus:border-[#789b32]"
            />
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label htmlFor="start-time" className="mb-2 block text-sm font-bold">
                Start time
              </label>
              <input
                id="start-time"
                type="time"
                value={startTime}
                onChange={(event) => setStartTime(event.target.value)}
                required
                className="w-full rounded-xl border border-gray-200 px-3 py-3 outline-none focus:border-[#789b32]"
              />
            </div>

            <div>
              <label htmlFor="end-time" className="mb-2 block text-sm font-bold">
                End time
              </label>
              <input
                id="end-time"
                type="time"
                value={endTime}
                onChange={(event) => setEndTime(event.target.value)}
                required
                className="w-full rounded-xl border border-gray-200 px-3 py-3 outline-none focus:border-[#789b32]"
              />
            </div>
          </div>

          <div>
            <label htmlFor="guest-count" className="mb-2 block text-sm font-bold">
              Number of guests
            </label>
            <input
              id="guest-count"
              type="number"
              min="1"
              max={studio.maxCapacity}
              value={guests}
              onChange={(event) => setGuests(event.target.value)}
              required
              className="w-full rounded-xl border border-gray-200 px-4 py-3 outline-none focus:border-[#789b32]"
            />
          </div>

          <div className="rounded-2xl bg-[#f5f7ef] p-4">
            <div className="flex justify-between gap-3">
              <span className="text-sm text-gray-600">Hourly rate</span>
              <span className="font-bold">
                ৳{studio.hourlyRate.toLocaleString("en-BD")}
              </span>
            </div>
            <div className="mt-2 flex justify-between gap-3">
              <span className="text-sm text-gray-600">Security deposit</span>
              <span className="font-bold">
                ৳{studio.securityDeposit.toLocaleString("en-BD")}
              </span>
            </div>
          </div>

          {bookingMessage && (
            <p
              role="status"
              className="rounded-xl bg-[#f5f7ef] p-3 text-sm text-gray-700"
            >
              {bookingMessage}
            </p>
          )}

          <button
            type="submit"
            className="w-full rounded-full bg-[#20231f] px-6 py-4 font-bold text-white hover:bg-[#42483d]"
          >
            Continue Booking
          </button>

          <p className="text-center text-xs leading-5 text-gray-500">
            This is a booking form preview. No booking will be saved yet.
          </p>
        </form>
      </section>
    </div>
  )}
</main>


);
}
